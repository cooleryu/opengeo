# Empty values run the local workspace without model charges.
# Optional Google Gemini API key for product understanding, answer auditing, and draft generation.
GEMINI_API_KEY=

# Optional DeepSeek API key for LLM analysis/generation (model: deepseek-flash, baseURL: https://api.deepseek.com).
DEEPSEEK_API_KEY=

# Other providers work the same way once selected in Settings (any model name the provider offers):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Or configure any OpenAI-compatible LLM endpoint directly:
OPENGEO_LLM_MODEL=
OPENGEO_LLM_API_KEY=
OPENGEO_LLM_BASE_URL=

# Optional local project materials directory; defaults to ./data/local-projects.
# GEO_LOCAL_PROJECTS_DIR=
